\verb{alpha_j = a_j + (q_j - p_j) d_j} (Eq. 7), and
\itemize{
\item \verb{G = sum_j 2 p_j q_j alpha_j alpha_j' + sum_\{j != x\} 2 lambda_jx alpha_j alpha_x'} (Eqs. 9-10),
\item \verb{D = sum_j (2 p_j q_j)^2 d_j d_j' + sum_\{j != x\} 4 lambda_jx^2 d_j d_x'}
(Eqs. 11-12),
